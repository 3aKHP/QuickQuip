# Default: all tracked text files → LF on checkout and in the index.
# Binary files are auto-detected and never touched.
* text=auto eol=lf

# Textual Windows launchers and cross-platform templates use LF.
*.ps1 text eol=lf
*.bat text eol=lf
*.cmd text eol=lf

# Image assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# SQLite / packed databases
*.db binary
*.sqlite binary
*.sqlite3 binary
