# Generic MCP sidecar template: wrap an upstream stdio-only MCP image with
# mcp-proxy, exposing SSE on port 8080.
#
# Usage:
#   1. Copy this file to docker/mcp-<your-server>.Dockerfile
#   2. Adjust the FROM image and the upstream command after `--`
#   3. Build via docker compose or `docker build`
#
# CRITICAL: Always include `--pass-environment` in ENTRYPOINT. mcp-proxy
# defaults to `--no-pass-environment`, which leaves the spawned child with
# an empty env, causing "<KEY> environment variable is required" errors
# even when the key is correctly set in the container.

# ── Pattern A: Debian-based Python venv upstream ──────────────────────────
# FROM <upstream-image>
# ARG PIP_INDEX_URL=https://pypi.org/simple
# ARG PIP_TRUSTED_HOST=
# RUN pip install --no-cache-dir --break-system-packages \
#     --index-url "${PIP_INDEX_URL}" \
#     ${PIP_TRUSTED_HOST:+--trusted-host "${PIP_TRUSTED_HOST}"} \
#     mcp-proxy
# EXPOSE 8080
# ENTRYPOINT ["mcp-proxy", "--pass-environment", "--port", "8080", "--host", "0.0.0.0", \
#             "--", "<upstream-command>"]

# ── Pattern B: Alpine-based Node upstream ─────────────────────────────────
# FROM <upstream-image>
# ARG PIP_INDEX_URL=https://pypi.org/simple
# ARG PIP_TRUSTED_HOST=
# RUN apk add --no-cache python3 py3-pip \
#  && pip3 install --no-cache-dir --break-system-packages \
#     --index-url "${PIP_INDEX_URL}" \
#     ${PIP_TRUSTED_HOST:+--trusted-host "${PIP_TRUSTED_HOST}"} \
#     mcp-proxy
# EXPOSE 8080
# ENTRYPOINT ["mcp-proxy", "--pass-environment", "--port", "8080", "--host", "0.0.0.0", \
#             "--", "<upstream-command>"]
