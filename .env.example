DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080
# 容器与进程的时区（日志、定时任务展示时间等），compose 部署默认 Asia/Shanghai。
TZ=Asia/Shanghai
ONEBOT_ACCESS_TOKEN=your_token_here
# 本机源码运行时，取消下一行注释并填写 OneBot 正向 WebSocket 地址；JSON 数组支持多个连接。
# compose 部署由编排提供容器网络中的默认地址。
# ONEBOT_WS_URLS=["ws://localhost:3001/"]
QQ_ACCOUNT=your_qq_account_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_claude_key_here
GEMINI_API_KEY=your_gemini_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
SEARXNG_BASE_URL=http://127.0.0.1:8888
# prod.example 运维模板使用外部 SearXNG，请填写下面的地址；缺失时 compose 校验失败。
# 根 docker-compose.example.yml 提供内置 SearXNG 和默认容器地址。
# QUICKQUIP_SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_PUBLIC_BASE_URL=http://127.0.0.1:8888/
SEARXNG_BIND_ADDRESS=127.0.0.1
SEARXNG_BIND_PORT=8888
SEARXNG_SECRET=change-this-secret
TAVILY_API_KEY=your_tavily_key_here
# 旧 TOML 迁移模板中的 openweather MCP 示例引用此天气 API key；启用该服务时填写。
# OWM_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
GITHUB_TOOLSETS=context,repos,issues,pull_requests,users,actions
GITHUB_READ_ONLY=
MCP_ARXIV_PAPERS_MOUNT=arxiv-papers:/root/.arxiv-mcp-server/papers
# prts_wiki MCP 鉴权 token，见 config/llm.json.example 的 settings.mcp.servers。
# MCP_PRTS_WIKI_TOKEN=
TIEBA_ENABLED=false
TIEBA_FORUM_KEYWORD=
TIEBA_FORUM_KEYWORDS=
TIEBA_SYNC_INTERVAL_SECONDS=900
TIEBA_MAX_POOL_SIZE=240
TIEBA_DETAIL_FETCH_LIMIT=18
TIEBA_RECENT_SENT_LIMIT=30
TIEBA_RANDOM_AVOID_RECENT=30
TIEBA_PREFER_IMAGE_THREADS=true
TIEBA_BROWSER_HEADLESS=true
TIEBA_BROWSER_CHANNEL=
WEB_ADMIN_PASSWORD=change-this-admin-password
WEB_ADMIN_SESSION_TTL_HOURS=168
# 会话绝对寿命（小时）：自创建起超过该时长必须重新登录，滑动续期不能突破该上限。
WEB_ADMIN_SESSION_MAX_AGE_HOURS=168
WEB_ADMIN_COOKIE_SECURE=auto
