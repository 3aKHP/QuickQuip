# Local environment files
.env
.env.*
!.env.example

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and type-check caches
.pytest_cache/
.pytest-tmp-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
# uv lockfile — permanently not tracked. requirements.txt is the dependency
# source of truth; uv.lock is auto-generated by the cross-platform pre-push
# hook's `uv run` (the [project] table triggers uv project mode). Daily work
# uses .venv/bin/python directly and does not generate it.
uv.lock

# Editor settings
.vscode/
.idea/

# Claude Code local state. Reviewed collaborator agents are tracked; settings
# and other machine-local Claude state stay ignored.
.claude/*
!.claude/agents/
!.claude/agents/*.md
CLAUDE.local.md

#ZCode
.zcode/

# Persistent data
data/
llm_about/**/*.yaml
!llm_about/*.yaml.example
!llm_about/_example/*.yaml
config/llm.toml
config/generation.toml
config/chat_rules.toml
config/games.toml
config/sensitive_words.toml
config/awakening.toml
config/personas/
config/llm.local.toml
config/llm.*.local.toml
!config/*.example
!config/personas.example/

# Private production deployment assets
/prod/
!/prod.example/

# Local private workspace
/d[e]v/

# Team-private MCP sidecar Dockerfiles (deployed via tar, not tracked)
docker/*.Dockerfile

# Frontend build output
dist/
node_modules/
