[runtime]
enabled = true
default_provider = "openai-main"
default_persona = "quickquip-default"
history_limit = 10
history_max_messages_per_group = 40
memory_limit = 6
memory_max_items_per_group = 200
max_prompt_chars = 4000
tool_calling_enabled = true
tool_max_rounds = 8
tool_max_calls_per_round = 16

# 保守版自动记忆抽取：每轮 LLM 回复结束后以独立的短 prompt 判断
# "这轮对话里有没有值得长期记住的关于发言者的稳定事实"，命中则
# 以 source="auto" 写入记忆库。默认关闭，开启后可按群用 /llm auto_memory
# on|off|reset 三态覆盖（或在 web admin 的"群 LLM"标签页切换）。
# auto_memory_prompt 为空时使用代码内置的默认判断 prompt。
auto_memory_enabled = false
auto_memory_prompt = ""
auto_memory_max_tokens = 256

[triggers]
default_prefix = "/ai"
allow_prefix = true
allow_at = true
empty_prompt_reply = "请在触发指令或艾特后面补上想说的话。"

# 自动联网判定：开启后模型会在需要最新信息时自行触发 search_web，
# 搜索走项目内 SearXNG。search_max_calls_per_round 控制每次工具调用
# 轮次中最多执行多少次搜索调用（1-32，默认 3）。
[triggers.auto_search]
enabled = false
search_max_calls_per_round = 3

# 快速判定专用模型（用于 context_rules llm_context、awakening 相关性/答疑判断等）。
# 留空则回退到 default_provider / default_model。推荐使用廉价小模型以降低成本。
[triggers.quick_judge]
provider_id = ""   # 引用 [[providers]] 中的 id，留空用 default_provider
model = ""         # 留空用该 provider 的 default_model
timeout = 2.0      # 秒
max_tokens = 64

[tools]
enabled = []
# 工具发现：工具较多时只常驻少量核心工具，其余工具由 tool_search
# 按能力描述搜索并在下一轮加载。auto 模式会在可延迟工具数超过
# discovery_min_tools 后启用，适合接入大批 MCP 工具时控制提示词体积。
discovery_mode = "auto"       # off | on | auto
discovery_min_tools = 10
discovery_search_limit = 5
discovery_max_loaded_tools = 12
always_loaded = ["tool_search", "tool_list", "get_identity", "list_memories", "search_web"]

[mcp]
enabled = true

# 支持的 transport：
#   "stdio" — 运行本地可执行文件（command + args），进程随 bot 启停；
#   "docker" — 宿主机上执行 `docker run -i --rm ...`。仅在裸机 + 原生 Docker daemon 环境可用；
#              容器化部署已不再挂载 docker.sock，本项目默认不推荐；
#   "http"  — MCP Streamable HTTP：单端点 POST，响应为 JSON 或内联 SSE，用 mcp-session-id 做会话；
#   "sse"   — 经典 MCP HTTP+SSE：GET 长连接事件流 + 服务端通过 endpoint 事件告知 POST 地址。

# 默认示例：HTTP transport（连到你自建或第三方的 MCP 反代）
[[mcp.servers]]
id = "prts_wiki"
transport = "http"
timeout_seconds = 30
url = "https://mcp.example.com/mcp"
headers = { Authorization = "Bearer ${MCP_PRTS_WIKI_TOKEN}" }

# ── MCP sidecar 模式（推荐用于容器化部署） ──────────────────────────────────
# 上游 stdio-only 的 MCP 镜像被 mcp-proxy 包一层，作为 compose sidecar 跑在
# 内部网络上，本 bot 以 transport = "sse" 直连。完整模板参考
# docker/mcp-example.Dockerfile.example 与你的私有部署编排。

[[mcp.servers]]
id = "tavily"
transport = "sse"
timeout_seconds = 30
url = "http://mcp-tavily:8080/sse"

[[mcp.servers]]
id = "fetch"
transport = "sse"
timeout_seconds = 30
url = "http://mcp-fetch:8080/sse"

# ── 以下 docker transport 示例仅供裸机部署参考（全部注释）──────────────────
# 这些 MCP 官方未提供 http/sse 入口，社区镜像直接 `docker run -i --rm` 启动。
# 想用的话：1) 确保 Docker CLI 可直接调用本机 daemon；2) 取消对应段落的注释。
#
# [[mcp.servers]]
# id = "github"
# transport = "docker"
# timeout_seconds = 30
# image = "ghcr.io/github/github-mcp-server"
# env = { GITHUB_PERSONAL_ACCESS_TOKEN = "${GITHUB_PERSONAL_ACCESS_TOKEN}", GITHUB_TOOLSETS = "${GITHUB_TOOLSETS:-context,repos,issues,pull_requests,users,actions}", GITHUB_READ_ONLY = "${GITHUB_READ_ONLY:-}" }
# include_tools = ["search_repositories", "get_file_contents", "search_code"]
# exclude_tools = ["delete_file", "merge_pull_request"]
#
# [[mcp.servers]]
# id = "tavily"
# transport = "docker"
# timeout_seconds = 30
# image = "mcp/tavily"
# env = { TAVILY_API_KEY = "${TAVILY_API_KEY}" }
#
# [[mcp.servers]]
# id = "arxiv"
# transport = "docker"
# enabled = false
# timeout_seconds = 30
# image = "mcp/arxiv-mcp-server"
# mounts = ["${MCP_ARXIV_PAPERS_MOUNT:-arxiv-papers:/root/.arxiv-mcp-server/papers}"]
#
# [[mcp.servers]]
# id = "fetch"
# transport = "docker"
# timeout_seconds = 30
# image = "mcp/fetch"
#
# [[mcp.servers]]
# id = "openweather"
# transport = "docker"
# timeout_seconds = 30
# image = "mcp/openweather"
# env = { OWM_API_KEY = "${OWM_API_KEY}" }
# ─────────────────────────────────────────────────────────────────────────────

# 每日早中晚播报配置。默认全局关闭；需要在群内执行 /briefing on 开启。
[daily_briefing]
enabled = false                    # 全局开关（false 时不注册定时任务）
morning_cron = "0 8 * * *"        # 每日 08:00 发送早报（回顾昨天）
noon_cron = "0 12 * * *"          # 每日 12:00 发送午报（回顾今天截至当前）
evening_cron = "0 22 * * *"       # 每日 22:00 发送晚报（回顾今天截至当前）
min_messages_for_llm = 5          # 低于此条数时跳过 LLM，改用模板回退
active_users_limit = 5            # 注入给 LLM 的活跃用户数量
hot_words_limit = 5               # 注入给 LLM 的热词数量
sample_messages_limit = 60        # 注入给 LLM 的代表性消息样本条数
max_context_chars = 40000         # 注入消息样本的总字符上限
max_output_chars = 320            # 播报正文最大字符数（超出会自动裁切）

# 模型级联：逐个尝试直到成功；"@default" 表示使用当前群绑定的默认模型。
model_cascade = [
    "@default",
    "openai-main/gpt-5.4",
    "claude-main/claude-sonnet-4-6",
]

# 每日群聊总结配置。默认全局关闭；需要在群内执行 /summary on 开启。
[daily_summary]
enabled = false               # 全局开关（false 时不注册定时任务）
# cron 表达式使用服务器本地时区（Asia/Shanghai，即北京时间）
generate_cron = "0 6 * * *"  # 每日 06:00 生成前一个06:00~06:00窗口的总结
publish_cron  = "0 12 * * *" # 每日 12:00 发布当日已生成的总结
min_messages  = 30            # 低于此条数时跳过生成（最小值 1）
summary_length_hint = 2000    # 字数目标，注入 prompt（最小值 100）

# 模型级联：逐个尝试直到成功；"@default" 表示使用当前群绑定的默认模型。
# 下方模型名称仅为示例，请替换为你自己的 provider_id/model_id。
model_cascade = [
    "gemini-main/gemini-3.1-pro-high",
    "claude-main/claude-sonnet-4-6",
    "openai-main/gpt-5.4",
    "@default",
    "deepseek/deepseek-chat",
]

# 图片 / 音视频等多模态产出配置已拆分到 config/generation.toml。
# 请复制 config/generation.toml.example 为 config/generation.toml 后单独维护。
# 当前运行时仍兼容旧版 [image_generation] 配置读取，但该写法只用于平滑迁移。

# 人格定义已拆分至 config/personas/ 目录，每个 .toml 文件对应一个人格。
# 参见 config/personas.example/ 中的示例文件。

# 风格模板 — 提取各 provider 重复的 style_overrides，通过 style_profile 引用。
# provider 级仍可叠加 style_overrides 做微调（追加在模板之后）。
[style_profiles]
openai_family = """
- 一定不要用AI助手的语言风格。你是聊天水群的群友。
- 不要分点列举，用自然的连贯句子回复。
- 不要在回复末尾追加反问句或引导性提问。
- 角色扮演时不要加入过多的旁白性质的括号。
"""
claude_family = """
- 一定不要用AI助手的语言风格。你是聊天水群的群友。
- 角色扮演时不要加入过多的旁白性质的括号。
"""

# 图片预处理前置层：将图片通过视觉模型转为文本描述，使非视觉模型（如 deepseek-chat）
# 也能"理解"图片内容。provider_id 指向一个支持 vision 的 provider。
[image_preprocessing]
enabled = false
provider_id = ""        # 用于视觉理解的 provider ID（如 "openai-main"）
model = ""              # 留空则用该 provider 的 default_model
max_tokens = 300        # 单张图片描述最大 token 数
temperature = 0.3       # 低温度确保描述准确
prompt = ""             # 自定义 system prompt，留空使用内置默认

[[providers]]
id = "openai-main"
protocol = "openai"
base_url = "https://your-openai-relay.example/v1"
api_key_env = "OPENAI_API_KEY"
default_model = "gpt-5.4"
models = ["gpt-5.4", "gpt-5.2", "gpt-5.1"]
style_profile = "openai_family"
timeout_seconds = 45
temperature = 0.8
max_output_tokens = 2048
# aliases = { gpt4 = "gpt-5.4", mini = "gpt-5.2" }  # 短别名 → 完整模型 ID，用于 /llm use
# fallback_urls = ["https://backup-relay.example/v1"]  # 主地址失败（5xx/网络）时自动切换
# proxy = "http://127.0.0.1:7890"  # HTTP(S) 代理地址，Docker 容器内可用宿主机网桥 IP；代理宕机时 fallback_urls 同样不可达
# user_agent = ""  # 注入 User-Agent 头；留空则不注入
# extra_body = {}  # 注入到每次请求体的额外字段，例如 { custom_header_field = "value" }

[[providers]]
id = "claude-main"
protocol = "claude"
base_url = "https://your-claude-relay.example/v1"
api_key_env = "ANTHROPIC_API_KEY"
default_model = "claude-sonnet-4-6"
models = ["claude-sonnet-4-6", "claude-opus-4-5", "claude-sonnet-4-5"]
style_profile = "claude_family"
# auth_method = "bearer"      # 认证方式："api_key"=x-api-key 头（默认），"bearer"=Authorization: Bearer
# prompt_caching = true       # 启用 Anthropic Prompt Caching（需中转站支持 CLI 格式）
# headers = { x-app = "cli" } # 自定义 HTTP 头；不设置 x-app 时自动补为 "cli"
timeout_seconds = 45
temperature = 0.8
max_output_tokens = 2048

[[providers]]
id = "gemini-main"
protocol = "gemini"
base_url = "https://your-gemini-relay.example/v1beta"
api_key_env = "GEMINI_API_KEY"
default_model = "gemini-3.1-pro-high"
models = ["gemini-3.1-pro-high", "gemini-3-flash-preview"]
style_profile = "claude_family"
timeout_seconds = 45
temperature = 0.5
max_output_tokens = 2048

[[providers]]
id = "deepseek"
protocol = "openai"
base_url = "https://api.deepseek.com/v1"
api_key_env = "DEEPSEEK_API_KEY"
default_model = "deepseek-chat"
models = ["deepseek-chat", "deepseek-reasoner"]
style_profile = "openai_family"
# non_vision_models = ["deepseek-chat", "deepseek-reasoner"]  # 非视觉模型：触发图片预处理+剥离
# non_vision_models = ["deepseek-chat", "deepseek-reasoner"]  # 标记为非视觉模型，触发图片预处理+剥离
timeout_seconds = 45
temperature = 0.5
max_output_tokens = 2048
