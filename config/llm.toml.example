[runtime]
enabled = true
default_provider = "openai-main"
default_persona = "quickquip-default"
# history_limit 自 1.14 起仅在会话级 /llm context_limit <n> 显式覆盖时生效
# （群聊/私聊均可；该会话退化为保留最新 n 行的滚动窗，上限 1024）；
# 默认路径由会话纪元自动管理。
history_limit = 10
# history_max_messages_per_group 已废弃（保留解析、不再生效）：存储裁剪由
# 会话纪元锚点驱动，硬上限统一为 2048 行。
history_max_messages_per_group = 40
memory_limit = 6
memory_max_items_per_group = 200
max_prompt_chars = 4000
tool_calling_enabled = true
tool_max_rounds = 8
tool_max_calls_per_round = 16

# 会话纪元（前缀缓存友好的只追加上下文窗口）。全局缺省，[[providers]] 可同名覆盖。
# context_tokens 是标尺（懒初始化与换模型的锚点跨度），不是阈值；
# cold_idle_seconds 宁短勿长（设短退化为滚动窗形态，设长则每轮全价且窗口更长）。
# 关系须满足 0 < cold_target < cold_trigger ≤ hot_target < cap，非法回退默认并告警。
# epoch_context_tokens = 8000
# epoch_cold_idle_seconds = 300     # Kimi 可放宽 600，DeepSeek 可放宽 21600（provider 级覆盖）
# epoch_cold_target_tokens = 4000
# epoch_cold_trigger_tokens = 5000
# epoch_hot_target_tokens = 32000
# epoch_cap_tokens = 64000

# 【现场】补丁（近期消息缓冲的 LLM 服役口径；仅全局，无 provider 覆盖）。
# 每轮最多把 budget token 的群内近期发言附为【现场】块；
# floor_seconds 是滑动保底窗：窗内消息即使已服役过也会重附（增量之外的保底）。
# recent_context_token_budget = 800
# recent_context_floor_seconds = 300

# 实际请求输入预算（应用侧估算口径，非模型平台上限）：每次 provider 请求前
# 对最终 payload 估算。按「provider 显式覆盖 > 模型窗口推导（窗口−输出预留）>
# 本缺省」解析；超限先把纪元窗口缩到热水位重建请求重试一次，仍超限才拒绝。
# provider 可单独覆盖。
# request_input_token_budget = 96000

# 历史 Loop 重放投影预算的推导下限：实际预算按「请求输入预算 − 纪元可见窗
# 上限 − system/工具预留 − 当前 Loop 比例预留」推导，配置了模型容量
# （model_context_windows 或内置窗口表命中）的 provider 自动放大到窗口量级；
# capacity unknown 时即本值。provider 可硬覆盖。
# agent_replay_loop_tokens = 4096

# Agent 执行记录保留（按 scope，先触顶者触发整 Loop 清理）
# agent_record_retention_days = 30
# agent_record_max_loops_per_scope = 1000
# agent_record_max_bytes_per_scope = 67108864

# 逐 Turn 交付（默认关闭：安装新版本不改变群内消息量；记录与重放始终工作）
# 开启后每次模型响应的普通正文先于工具执行分段外发；阈值/上限为 Unicode
# code point 口径，独立于 OneBot 协议报文长度限制。
# agent_delivery_enabled = false
# reply_split_threshold_chars = 800
# reply_chunk_max_chars = 1200
# reply_send_interval_ms = 800
# reply_max_chunks_per_loop = 64

# 上游 429/5xx/网络错误的自动重试（所有 LLM 调用路径统一生效；探活/诊断不受影响）
# retry_max_attempts 含首次调用；第 n 次重试延迟 = base_delay * 2^n * (1 + 随机抖动)
retry_max_attempts = 3
retry_base_delay = 1.0
retry_jitter = 0.5  # 抖动比例，0-1，0 为关闭

# 保守版自动记忆抽取：每轮 LLM 回复结束后以独立的短 prompt 判断
# "这轮对话里有没有值得长期记住的关于发言者的稳定事实"，命中则
# 以 source="auto" 写入记忆库。默认关闭，开启后可按群用 /llm auto_memory
# on|off|reset 三态覆盖（或在 web admin 的"群 LLM"标签页切换）。
# auto_memory_prompt 为空时使用代码内置的默认判断 prompt。
auto_memory_enabled = false
auto_memory_prompt = ""
auto_memory_max_tokens = 256

[triggers]
default_prefix = "/ai"
allow_prefix = true
allow_at = true
empty_prompt_reply = "请在触发指令或艾特后面补上想说的话。"

# 自动联网判定：开启后模型会在需要最新信息时自行触发 search_web，
# 搜索走项目内 SearXNG。search_max_calls_per_round 控制每次工具调用
# 轮次中最多执行多少次搜索调用（1-32，默认 3）。
# 本段只作用于 search_web 路径；provider 的 builtin_search（见 gemini 段）
# 开启后该 provider 会话移除 search_web，改走服务端 grounding 检索。
[triggers.auto_search]
enabled = false
search_max_calls_per_round = 3

# 快速判定专用模型（用于 context_rules llm_context、awakening 相关性/答疑判断等）。
# 留空则回退到 default_provider / default_model。推荐使用廉价小模型以降低成本。
[triggers.quick_judge]
provider_id = ""   # 引用 [[providers]] 中的 id，留空用 default_provider
model = ""         # 留空用该 provider 的 default_model
timeout = 2.0      # 秒；reasoning 模型延迟更高，需调大（如 6.0）
max_tokens = 64    # reasoning 模型的思考 token 计入该预算，需调大（如 256）

[tools]
# enabled 是工具名单：留空 [] 用默认白名单 + 全部 MCP 工具；
# 非空时的作用方式由 enabled_mode 决定。
#   append  （默认）在默认白名单 + MCP 工具之上追加——启用可选内置工具
#           （如 draw_svg 画图，还需在 generation.toml [svg] 开 enabled；
#           manage_scheduled_messages 让 LLM 管理当前群定时消息）写这里。
#   replace 精确过滤：只暴露所列工具（含 MCP），用于主动收敛暴露面。
enabled = []
enabled_mode = "append"
# 工具发现：工具较多时只常驻少量核心工具，其余工具由 tool_search
# 按能力描述搜索并在下一轮加载。auto 模式会在可延迟工具数超过
# discovery_min_tools 后启用，适合接入大批 MCP 工具时控制提示词体积。
discovery_mode = "auto"       # off | on | auto
discovery_min_tools = 10
discovery_search_limit = 5
discovery_max_loaded_tools = 12
always_loaded = ["tool_search", "tool_list", "get_identity", "list_memories", "search_web"]

[mcp]
enabled = false

# 支持的 transport：
#   "stdio" — 运行本地可执行文件（command + args），进程随 bot 启停；
#   "docker" — 宿主机上执行 `docker run -i --rm ...`。仅在裸机 + 原生 Docker daemon 环境可用；
#              容器化部署已不再挂载 docker.sock，本项目默认不推荐；
#   "http"  — MCP Streamable HTTP：单端点 POST，响应为 JSON 或内联 SSE，用 mcp-session-id 做会话；
#   "sse"   — 经典 MCP HTTP+SSE：GET 长连接事件流 + 服务端通过 endpoint 事件告知 POST 地址。

# 默认示例：HTTP transport（连到你自建或第三方的 MCP 反代）
[[mcp.servers]]
id = "prts_wiki"
transport = "http"
timeout_seconds = 30
url = "https://mcp.example.com/mcp"
headers = { Authorization = "Bearer ${MCP_PRTS_WIKI_TOKEN}" }

# ── 双协议纪元（dual-era）协商 ─────────────────────────────────────────────
# negotiation 控制 MCP 协议协商模式（仅 transport = "http" 生效）：
#   "legacy" — 使用 initialize 握手 + mcp-session-id（默认，兼容所有旧 Server）
#   "auto"   — 先发 server/discover 探测；探测到 modern 就走 modern，否则回退 legacy
#   "modern" — 只用 modern 协议（2026-07-28），不回退
#
# 缺省（不填 negotiation）= "legacy"，行为与旧版完全一致。
#
# protocol_version 仅 legacy 使用（initialize 时的协议版本 pin）。
# supported_protocol_versions 仅 modern/auto 使用（客户端声明的可接受版本列表）。
#
# [[mcp.servers]]
# id = "modern_server"
# transport = "http"
# negotiation = "auto"
# supported_protocol_versions = ["2026-07-28"]
# url = "https://modern-mcp.example.com/mcp"

# ── MCP sidecar 模式（legacy，仅在没有宿主机 HTTP 服务时使用） ──────────────
# 生产容器优先通过已鉴权的 HTTPS Streamable HTTP 网关连接宿主机上的 MCP
# 服务；以下 sidecar 示例保留用于独立环境，不应与宿主机 MCP 服务重复部署。

# [[mcp.servers]]
# id = "tavily"
# transport = "sse"
# timeout_seconds = 30
# url = "http://mcp-tavily:8080/sse"
#
# [[mcp.servers]]
# id = "fetch"
# transport = "sse"
# timeout_seconds = 30
# url = "http://mcp-fetch:8080/sse"

# ── 以下 docker transport 示例仅供裸机部署参考（全部注释）──────────────────
# 这些 MCP 官方未提供 http/sse 入口，社区镜像直接 `docker run -i --rm` 启动。
# 想用的话：1) 确保 Docker CLI 可直接调用本机 daemon；2) 取消对应段落的注释。
#
# [[mcp.servers]]
# id = "github"
# transport = "docker"
# timeout_seconds = 30
# image = "ghcr.io/github/github-mcp-server"
# env = { GITHUB_PERSONAL_ACCESS_TOKEN = "${GITHUB_PERSONAL_ACCESS_TOKEN}", GITHUB_TOOLSETS = "${GITHUB_TOOLSETS:-context,repos,issues,pull_requests,users,actions}", GITHUB_READ_ONLY = "${GITHUB_READ_ONLY:-}" }
# include_tools = ["search_repositories", "get_file_contents", "search_code"]
# exclude_tools = ["delete_file", "merge_pull_request"]
#
# [[mcp.servers]]
# id = "tavily"
# transport = "docker"
# timeout_seconds = 30
# image = "mcp/tavily"
# env = { TAVILY_API_KEY = "${TAVILY_API_KEY}" }
#
# [[mcp.servers]]
# id = "arxiv"
# transport = "docker"
# enabled = false
# timeout_seconds = 30
# image = "mcp/arxiv-mcp-server"
# mounts = ["${MCP_ARXIV_PAPERS_MOUNT:-arxiv-papers:/root/.arxiv-mcp-server/papers}"]
#
# [[mcp.servers]]
# id = "fetch"
# transport = "docker"
# timeout_seconds = 30
# image = "mcp/fetch"
#
# [[mcp.servers]]
# id = "openweather"
# transport = "docker"
# timeout_seconds = 30
# image = "mcp/openweather"
# env = { OWM_API_KEY = "${OWM_API_KEY}" }
# ─────────────────────────────────────────────────────────────────────────────

# 每日早中晚播报配置。默认全局关闭；需要在群内执行 /briefing on 开启。
[daily_briefing]
enabled = false                    # 全局开关（false 时不注册定时任务）
morning_cron = "0 8 * * *"        # 每日 08:00 发送早报（回顾昨天）
noon_cron = "0 12 * * *"          # 每日 12:00 发送午报（回顾今天截至当前）
evening_cron = "0 22 * * *"       # 每日 22:00 发送晚报（回顾今天截至当前）
min_messages_for_llm = 5          # 低于此条数时跳过 LLM，改用模板回退
active_users_limit = 5            # 注入给 LLM 的活跃用户数量
hot_words_limit = 5               # 注入给 LLM 的热词数量
sample_messages_limit = 60        # 注入给 LLM 的代表性消息样本条数
max_context_chars = 40000         # 注入消息样本的总字符上限
max_output_chars = 320            # 播报正文最大字符数（超出会自动裁切）

# 模型级联：逐个尝试直到成功；"@default" 表示使用当前群绑定的默认模型。
# （仅 enabled = true 时才校验 cascade 引用的 provider，关闭时不产生 load_error）
model_cascade = [
    "@default",
    "openai-main/gpt-5.4",
    "claude-main/claude-sonnet-4-6",
]

# 每日群聊总结配置。默认全局关闭；需要在群内执行 /summary on 开启。
[daily_summary]
enabled = false               # 全局开关（false 时不注册定时任务）
# cron 表达式使用服务器本地时区（Asia/Shanghai，即北京时间）
generate_cron = "0 6 * * *"  # 每日 06:00 生成前一个06:00~06:00窗口的总结
publish_cron  = "0 12 * * *" # 每日 12:00 发布当日已生成的总结
min_messages  = 30            # 低于此条数时跳过生成（最小值 1）
summary_length_hint = 2000    # 字数目标，注入 prompt（最小值 100）

# 模型级联：逐个尝试直到成功；"@default" 表示使用当前群绑定的默认模型。
# 下方模型名称仅为示例，请替换为你自己的 provider_id/model_id。
# （仅 enabled = true 时才校验 cascade 引用的 provider，关闭时不产生 load_error）
model_cascade = [
    "gemini-main/gemini-3.1-pro-high",
    "claude-main/claude-sonnet-4-6",
    "openai-main/gpt-5.4",
    "@default",
    "deepseek/deepseek-chat",
]

# 群周报 — 每周自动生成上周群聊回顾。
# 数据源复用词云采集（wordcloud_msgs，always-on 不删除），按天采样后套用日报同款 LLM 管线。
# 命令：/summary weekly on|off|status|now（在群里开启/关闭/查状态/立即生成上周）
# period 标识为 ISO 周号（如 2026-W24）。
[weekly_report]
enabled = false                  # 全局开关（false 时不注册定时任务）
generate_cron = "0 9 * * 1"      # 每周一 09:00 生成上周周报
publish_cron  = "0 10 * * *"     # 每天 10:00 发布（周一发新报告，其余日子补发未发布的）
min_messages  = 100              # 低于此条数时跳过生成（最小值 1）
length_hint   = 2000             # 字数目标，注入 prompt（最小值 200）
sample_per_day = 50              # 每天采样消息数上限，控制喂给 LLM 的总量（最小值 1）
# 模型级联（仅 enabled = true 时才校验引用的 provider，关闭时不产生 load_error）
model_cascade = [
    "gemini-main/gemini-3.1-pro-high",
    "claude-main/claude-sonnet-4-6",
    "openai-main/gpt-5.4",
    "@default",
]

# 群月报 — 每月自动生成上月群聊回顾。period 标识为年月（如 2026-06）。
# 命令：/summary monthly on|off|status|now
[monthly_report]
enabled = false                  # 全局开关
generate_cron = "0 9 1 * *"      # 每月 1 日 09:00 生成上月月报
publish_cron  = "0 10 * * *"     # 每天 10:00 发布（1 日发新报告，其余日子补发未发布的）
min_messages  = 300              # 低于此条数时跳过生成
length_hint   = 2500             # 字数目标（最小值 200）
sample_per_day = 20              # 月报跨度长，每天采样更少（最小值 1）
# 模型级联（仅 enabled = true 时才校验引用的 provider，关闭时不产生 load_error）
model_cascade = [
    "gemini-main/gemini-3.1-pro-high",
    "claude-main/claude-sonnet-4-6",
    "openai-main/gpt-5.4",
    "@default",
]

# 图片 / 音视频等多模态产出配置已拆分到 config/generation.toml。
# 请复制 config/generation.toml.example 为 config/generation.toml 后单独维护。
# 当前运行时仍兼容旧版 [image_generation] 配置读取，但该写法只用于平滑迁移。

# 人格定义已拆分至 config/personas/ 目录，每个 .toml 文件对应一个人格。
# 参见 config/personas.example/ 中的示例文件。

# 风格模板 — 提取各 provider 重复的 style_overrides，通过 style_profile 引用。
# provider 级仍可叠加 style_overrides 做微调（追加在模板之后）。
[style_profiles]
openai_family = """
- 一定不要用AI助手的语言风格。你是聊天水群的群友。
- 不要分点列举，用自然的连贯句子回复。
- 不要在回复末尾追加反问句或引导性提问。
- 角色扮演时不要加入过多的旁白性质的括号。
"""
claude_family = """
- 一定不要用AI助手的语言风格。你是聊天水群的群友。
- 角色扮演时不要加入过多的旁白性质的括号。
"""

# 图片预处理前置层：仅当主模型列入 non_vision_models 时调用视觉模型生成转述。
# provider_id 和 model 必须指向支持图片输入的模型。单轮最多处理 5 张图片；
# 任一图片识别失败时终止本轮，避免非视觉主模型在缺少图像信息时猜测。
[image_preprocessing]
enabled = false
provider_id = ""        # 用于视觉理解的 provider ID（如 "openai-main"）
model = ""              # 留空则用该 provider 的 default_model
max_tokens = 300        # 单张图片描述最大 token 数，运行时限制为 80-2048
temperature = 0.3       # 低温度确保描述准确
prompt = ""             # 自定义 system prompt，留空使用内置默认

[[providers]]
id = "openai-main"
protocol = "openai"
base_url = "https://your-openai-relay.example/v1"
api_key_env = "OPENAI_API_KEY"
default_model = "gpt-5.4"
models = ["gpt-5.4", "gpt-5.2", "gpt-5.1"]
style_profile = "openai_family"
timeout_seconds = 45
temperature = 0.8
max_output_tokens = 2048
# aliases = { gpt4 = "gpt-5.4", mini = "gpt-5.2" }  # 短别名 → 完整模型 ID，用于 /llm use
# fallback_urls = ["https://backup-relay.example/v1"]  # 主地址失败（5xx/网络）时自动切换
# proxy = "http://127.0.0.1:7890"  # HTTP(S) 代理地址，Docker 容器内可用宿主机网桥 IP；代理宕机时 fallback_urls 同样不可达
# user_agent = ""  # 注入 User-Agent 头；留空则不注入
# extra_body = {}  # 注入到每次请求体的额外字段，例如 { custom_header_field = "value" }

[[providers]]
id = "claude-main"
protocol = "claude"
base_url = "https://your-claude-relay.example/v1"
api_key_env = "ANTHROPIC_API_KEY"
default_model = "claude-sonnet-4-6"
models = ["claude-sonnet-4-6", "claude-opus-4-5", "claude-sonnet-4-5"]
style_profile = "claude_family"
# auth_method = "bearer"      # 认证方式："api_key"=x-api-key 头（默认），"bearer"=Authorization: Bearer
# prompt_caching = true       # 启用 Anthropic Prompt Caching（需中转站支持 CLI 格式）
# headers = { x-app = "cli" } # 自定义 HTTP 头；不设置 x-app 时自动补为 "cli"
# model_context_windows = { "claude-sonnet-4-6" = 200000 }  # wire 模型 → 上下文窗口；未配置的模型按内置家族表解析，中继自定义模型名建议显式声明
# agent_replay_loop_tokens = 131072  # 重放投影预算硬覆盖（优先于按窗口推导）
# request_input_token_budget = 96000 # 请求输入预算硬覆盖（优先于按窗口推导）
timeout_seconds = 45
temperature = 0.8
max_output_tokens = 2048

[[providers]]
id = "gemini-main"
protocol = "gemini"
base_url = "https://your-gemini-relay.example/v1beta"
api_key_env = "GEMINI_API_KEY"
default_model = "gemini-3.1-pro-high"
models = ["gemini-3.1-pro-high", "gemini-3-flash-preview"]
style_profile = "claude_family"
# auth_method = "bearer"  # 原生 Gemini 网关可用 Bearer；启用后 key 仅进 Authorization，不进 URL
# builtin_search = true   # 声明 google_search 服务端搜索工具（grounding）：检索由 provider 侧
#                         # 执行并计费；开启后该 provider 会话移除 search_web 工具，回复末尾
#                         # 自动附上检索来源。仅 gemini 协议生效，其他协议下该键不生效。
#                         # 注意：google_search 与 function calling 组合仅 Gemini 3 系列模型支持，
#                         # 2.x 模型请关闭本键或全局 tool_calling_enabled，否则请求会被 API 拒绝。
timeout_seconds = 45
temperature = 0.5
max_output_tokens = 2048

[[providers]]
id = "deepseek"
protocol = "openai"
base_url = "https://api.deepseek.com/v1"
api_key_env = "DEEPSEEK_API_KEY"
default_model = "deepseek-chat"
models = ["deepseek-chat", "deepseek-reasoner"]
style_profile = "openai_family"
# non_vision_models = ["deepseek-chat", "deepseek-reasoner"]  # 非视觉模型：触发图片预处理+剥离
# DeepSeek 前缀缓存存活以小时计：冷场判定放宽到 6h（全局默认 300s 对它太短）
epoch_cold_idle_seconds = 21600
timeout_seconds = 45
temperature = 0.5
max_output_tokens = 2048

# ════════════════════════════════════════════════════════════════════════════
# 模型定价（per-MTok，USD）—— 供 LLM 用量/成本统计计算 cost_usd。
#   · match_pricing 先查 "provider_id/model"（per-provider 覆盖，如某中转实际价），
#     miss 回退纯 "model"（官方价默认），再 miss → 标记未定价（cost=0，仪表盘可见）。
#   · 第三方中转：按模型 id 对应官方价填 model 默认，再按中转实际计费加 provider 覆盖。
#   · cache_read/write_per_mtok：模型无该缓存机制（OpenAI '–'、Google 存储型缓存）时省略。
#   · 国产 CNY 价按汇率换算成 USD。未填价格的模型在用量页显示"未定价"（priced=0）。
# ════════════════════════════════════════════════════════════════════════════

# 纯 model 名 = 官方价默认（所有 provider 的该 model 共享）
[pricing.models."deepseek-chat"]
input_per_mtok = 0.14
output_per_mtok = 0.28
cache_read_per_mtok = 0.003

# "provider_id/model" = per-provider 覆盖（某中转实际价，优先于 model 默认）
# [pricing.models."my-provider/deepseek-chat"]
# input_per_mtok = 0.20   # 例：该中转加价
# output_per_mtok = 0.40
