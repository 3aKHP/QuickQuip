# 敏感词过滤器配置示例
#
# 将本模板复制为 Git 忽略的 config/sensitive_words.toml，按实际部署环境与合规要求填写词条。
# 修改保存后，在群内执行 /llm reload 或重启 Bot 即可加载生效（详见 docs/admin/sensitive-filter.md）。
#
# 两级词表：
#   [block.<类别名>] — 阻断请求、替换输出或跳过统计，适用于部署环境中明确需要拦截的词条。
#   [soft.<类别名>]  — 仅记录命中日志（quickquip.common.sensitive_filter）供观察评估，请求照常放行。
#
# 覆盖范围：
#   - 聊天与多模态文本链路：普通 LLM 输入/输出与历史回放、工具参数与结果、Skill 清单/正文/资源/脚本输出、
#     /draw 与 /tts 及音乐生成输入、歌词输出、ASR 转写后文本、视觉转述文本、/defectify、/turmfluch 等；
#   - 全局出口与展示兜底：全局 OneBot 文本出口守卫（outbound_api:*，拦截纯文本与合并转发节点）、
#     长文合并转发与 PNG 长图降级发送前预扫（outbound_long:*），以及词频统计与词云（静默跳过命中 block 的消息）。
#
# 匹配规则：
#   匹配前统一折叠大小写，并剔除零宽字符与 ASCII 空白（例如词条“杀猪盘”同样会命中“杀 猪 盘”）；
#   拼音、谐音与同形字需作为独立词条添加。建议先以精简词表配合 [soft] 观察命中日志，确认无误伤后再升为 [block]。

# ─────────────────────────────────────────────────────────────────────
# BLOCK 级别 —— 命中时拦截请求、替换文本或静默剔除
# ─────────────────────────────────────────────────────────────────────

[block.fraud]
# 反诈示例：按实际匹配情况检查误判。
words = [
    "杀猪盘",
    "出售身份证",
    "出售银行卡",
    "刷单兼职",
    "兼职刷单",
    "高薪招嫖",
    "走投无路借钱",
]

[block.gambling]
# 赌博平台引流示例。
words = [
    "网赌平台",
    "私彩平台",
    "菠菜担保",
    "信用盘出租",
]

[block.account_trade]
# 账号买卖与跑分：黑灰产高频词。
words = [
    "跑分平台",
    "跑分接单",
    "支付宝跑分",
    "微信跑分",
    "出U换U",
    "U商对接",
]

[block.illegal_service]
# 违法服务：代办、伪造类。
words = [
    "代办毕业证",
    "伪造身份证",
    "伪造营业执照",
    "私家侦探查询",
    "查开房记录",
]

# ─────────────────────────────────────────────────────────────────────
# SOFT 级别 —— 仅记录命中日志，不阻断正常请求
# ─────────────────────────────────────────────────────────────────────

[soft.spam_pattern]
# 推广话术：单独不一定恶意，但密集出现可能是水军/广告。
words = [
    "加微信领取",
    "扫码进群",
    "私聊详谈",
    "了解更多请联系",
]

[soft.suspicious_ask]
# 边缘提问：用于监控群成员是否在试探 bot 边界。
words = [
    "怎么绕过",
    "如何破解",
    "怎么规避监管",
]

# ─────────────────────────────────────────────────────────────────────
# 按实际部署环境补充自定义类别
#
# 类别名由部署者自由定义（如 [block.abuse]、[soft.review]），均使用 words 字符串数组。
# 维护私有词表时可参考以下来源（完整排障与词表保护要求见 docs/admin/sensitive-filter.md）：
#   1. 上游模型渠道返回安全拒答时的触发短语（结合上下文挑出真正触发风控的词条）；
#   2. 测试群实际对话中出现的垃圾引流或违规话术；
#   3. 许可证合规的公开反垃圾词库（先筛选并放入 [soft] 观察误判率，再按需移入 [block]）。
# ─────────────────────────────────────────────────────────────────────
