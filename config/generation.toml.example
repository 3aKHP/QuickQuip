[image]
enabled = false
default_model = "dalle3"
# prompt_blocklist = ["naked", "gore", "blood"]

# 图片生成配置已从 llm.toml 中拆出，统一归入 generation.toml。
# 当前版本仍兼容旧的 [image_generation] 读取方式，但新配置建议全部写在这里，
# 便于后续接入音频、视频等更多产出模态。
#
# 支持的 protocol（每个 [[image.providers]] 条目配置）：
#   openai_images   — POST /images/generations，兼容 OpenAI DALL-E/GPT Image 系列
#                     以及火山方舟 Seedream 系列（ARK API 完全兼容此格式）。
#                     有输入图片时自动切换至 POST /images/edits（multipart/form-data）。
#   gemini_imagen   — POST /models/{model}:generateContent，Gemini 原生图片生成格式；
#                     输入图片以 inlineData 注入。
#   minimax_images  — POST /image_generation，MiniMax Image-01 格式；size 填宽高比（如
#                     "1:1"/"16:9"）；输入图片以 subject_reference 注入（角色参考模式）。
#
# [[image.providers]] 字段：
#   id              — provider 唯一标识
#   protocol        — 见上方说明
#   base_url        — API 根端点（handlers 自动追加协议路径）
#   api_key_env     — 读取 API key 的环境变量名
#   timeout_seconds — 请求超时（图片生成通常较慢，建议 120+）
#
# [[image.providers.models]] 字段（属于上方最近一个 provider）：
#   id              — 模型唯一标识，用于 /draw <id> <描述> 选模型
#   label           — 可选显示名称
#   model           — 调用 API 时传入的模型 ID
#   size            — openai_images/gemini：图片尺寸（如 "1024x1024"）；
#                     minimax_images：宽高比（如 "1:1"、"16:9"、"9:16"）；
#                     Seedream 还支持 "2K"、"3K" 等写法
#   quality         — openai_images 协议下有效：standard | hd | low | medium | high | auto；
#                     设为 "" 则不发送此参数
#   response_format — openai_images 协议下有效：b64_json（默认）| url | ""（不发送）

[[image.providers]]
id = "openai-main"
protocol = "openai_images"
base_url = "https://your-openai-relay.example/v1"
api_key_env = "OPENAI_API_KEY"
timeout_seconds = 120

[[image.providers.models]]
id = "dalle3"
label = "DALL-E 3"
model = "dall-e-3"
size = "1024x1024"
quality = "standard"

[audio]
enabled = false
default_model = "minimax-speech"

# 当前实现优先支持 MiniMax 同步 TTS（/tts）。
# 如后续需要长文本异步任务，可把 provider.protocol 改为 minimax_t2a_async，
# 底层已支持 create/query/retrieve 链路，但首版命令仍默认走同步直出。
#
# [[audio.providers]] 字段：
#   id              — provider 唯一标识
#   protocol        — minimax_t2a_http | minimax_t2a_async | openai_tts | http_tts
#   base_url        — API 根地址（MiniMax 默认 https://api.minimaxi.com/v1）
#   api_key_env     — API key 环境变量名（openai_tts / http_tts 可省略，本地无鉴权）
#   timeout_seconds — 请求超时
#
# [[audio.providers.models]] 字段：
#   id              — 模型唯一标识，用于 /tts <id> <文本>
#   model           — TTS 模型名（MiniMax: speech-2.8-hd；OpenAI: tts-1 等）
#   voice_id        — 默认音色 ID，可被 /tts --voice 覆盖
#   format          — mp3 | wav | flac | pcm
#   sample_rate     — 采样率
#   bitrate         — 比特率
#   channel         — 声道数
#   speed / vol / pitch / emotion — 默认语音风格参数
#   output_format   — 建议使用 hex，便于直接转成 QQ 语音段
#   extra_body      — 自定义字段（见下方 openai_tts / http_tts 示例）
#
# 本地/自建 TTS（openai_tts / http_tts）：
#   openai_tts  — OpenAI TTS 兼容协议（POST /audio/speech），覆盖 edge-tts / GPT-SoVITS /
#                 piper 等本地服务的 OpenAI 兼容包装。无 api_key_env 时不附加鉴权头。
#   http_tts    — 原始 HTTP POST，请求体字段从 model 的 extra_body 模板派生，
#                 支持 {text} / {voice} 占位符替换，适配非 OpenAI 格式的本地服务。
#                 以下划线开头的键（如 __path、__method）是内部控制字段，不会进入请求体。

[[audio.providers]]
id = "minimax-audio"
protocol = "minimax_t2a_http"
base_url = "https://api.minimaxi.com/v1"
api_key_env = "MINIMAX_API_KEY"
timeout_seconds = 120

[[audio.providers.models]]
id = "minimax-speech"
label = "MiniMax Speech 2.8 HD"
model = "speech-2.8-hd"
voice_id = "male-qn-qingse"
format = "mp3"
sample_rate = 32000
bitrate = 128000
channel = 1
speed = 1.0
vol = 1.0
pitch = 0.0
output_format = "hex"

# ── 本地/自建 TTS 示例（按需取消注释）──────────────────────────────────
#
# # OpenAI TTS 兼容协议：适配 edge-tts / GPT-SoVITS / 各类 OpenAI 兼容 tts gateway
# [[audio.providers]]
# id = "local-openai-tts"
# protocol = "openai_tts"
# base_url = "http://127.0.0.1:8000/v1"
# # api_key_env = "LOCAL_TTS_KEY"   # 本地无鉴权时可省略
# timeout_seconds = 60
#
# [[audio.providers.models]]
# id = "local-tts"
# label = "本地 TTS"
# model = "tts-1"
# voice_id = "alloy"
# format = "mp3"
# # extra_body 可声明静态音色列表，供 /tts voices 查询：
# # [audio.providers.models.extra_body]
# # voices = ["alloy", "echo", "fable", "onyx", "nova", "shimmer"]
#
# # 原始 HTTP POST 协议：自定义请求体字段，适配非 OpenAI 格式的本地服务
# # 以下划线开头的键为内部控制字段（__path 请求路径、__method HTTP 方法），不进入请求体
# [[audio.providers]]
# id = "local-http-tts"
# protocol = "http_tts"
# base_url = "http://127.0.0.1:5000"
# timeout_seconds = 60
#
# [[audio.providers.models]]
# id = "piper-tts"
# label = "Piper TTS"
# model = "zh_CN-huayan-medium"
# voice_id = "huayan"
# format = "wav"
# [audio.providers.models.extra_body]
# __path = "/synthesize"
# __method = "POST"
# text = "{text}"
# voice = "{voice}"
# model_id = "zh_CN-huayan-medium"

[asr]
enabled = false
default_model = "whisper"
max_audio_bytes = 26214400

# ASR 用于把收到的 QQ 语音消息转写为文字并注入 LLM 上下文。
# OneBot 协议端如果在 record 段中直接提供 text/transcript/transcription，
# QuickQuip 会优先使用该文本；否则调用 OneBot get_record 转码，再交给这里的 ASR provider。
#
# 当前支持的 protocol：
#   openai_transcriptions — POST /audio/transcriptions，兼容 OpenAI Whisper 风格接口
#
# [[asr.providers]] 字段：
#   id              — provider 唯一标识
#   protocol        — openai_transcriptions
#   base_url        — API 根端点，例如 https://api.openai.com/v1
#   api_key_env     — API key 环境变量名
#   timeout_seconds — 请求超时
#
# [[asr.providers.models]] 字段：
#   id              — 模型唯一标识
#   model           — 调用 API 时传入的模型 ID
#   language        — 可选语言提示，例如 zh
#   prompt          — 可选上下文提示
#   response_format — json | text

[[asr.providers]]
id = "openai-asr"
protocol = "openai_transcriptions"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
timeout_seconds = 60

[[asr.providers.models]]
id = "whisper"
label = "Whisper"
model = "whisper-1"
language = "zh"
response_format = "json"

[music]
enabled = false
default_model = "minimax-music"

# 当前实现只覆盖“纯文本入参”的 MiniMax 音乐能力：
#   - /music lyrics <主题>：歌词生成
#   - /music lyrics edit <要求>：基于现有歌词编辑/续写（可用 --lyrics 或回复消息传入）
#   - /music <风格描述>：先写词，再生成歌曲
#   - /music --instrumental <风格描述>：纯音乐生成
#
# 当前不会接入翻唱前处理、音频参考、cover_feature_id 等依赖音频输入的链路。
#
# [[music.providers]] 字段：
#   id              — provider 唯一标识
#   protocol        — minimax_music
#   base_url        — MiniMax API 根地址，默认 https://api.minimaxi.com/v1
#   api_key_env     — API key 环境变量名
#   timeout_seconds — 请求超时（音乐生成一般比 TTS 更慢，建议 180+）
#
# [[music.providers.models]] 字段：
#   id              — 模型唯一标识，用于 /music <id> <风格描述>
#   model           — MiniMax 音乐模型名，当前文本生成功能建议使用 music-2.6 / music-2.6-free
#   sample_rate     — 音频采样率
#   bitrate         — 比特率
#   format          — mp3 | wav | flac
#   output_format   — 建议使用 hex，便于直接转成 QQ 语音段
#   add_watermark   — 是否在非流式响应末尾添加水印
#   lyrics_optimizer — 传入歌词时是否启用官方歌词优化

[[music.providers]]
id = "minimax-music-provider"
protocol = "minimax_music"
base_url = "https://api.minimaxi.com/v1"
api_key_env = "MINIMAX_API_KEY"
timeout_seconds = 180

[[music.providers.models]]
id = "minimax-music"
label = "MiniMax Music 2.6"
model = "music-2.6"
sample_rate = 44100
bitrate = 256000
format = "mp3"
output_format = "hex"
lyrics_optimizer = true

