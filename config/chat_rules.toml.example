# QuickQuip 自定义回复规则配置示例
#
# 将本文件复制为 config/chat_rules.toml 后使用（该文件已被 .gitignore 排除在版本控制之外）。
# chat_rules.toml 是部署级私有配置，适合存放群特有的彩蛋规则和内部梗。
#
# ══════════════════════════════════════════════════════════
# [rate_limit_rules] — 限流桶定义
# ══════════════════════════════════════════════════════════
#
# 格式：桶名 = {global_limit = N, user_limit = M, scope = "group" | "global", window = S}
#   global_limit  - 窗口内桶内最多触发次数
#   user_limit    - 窗口内桶内同一用户最多触发次数
#   scope         - （可选）分桶作用域，不写默认 "group"：
#                   "group"  = 按群独立分桶，群 A 的触发不消耗群 B 的预算，
#                              私聊场景退化到合并桶
#                   "global" = 所有群 + 私聊合并到同一个桶，用于保护跨会话
#                              共享资源（LLM、搜索、爬虫）
#   window        - （可选）滑动窗口秒数，不写默认 60s。适合做长冷却的彩蛋桶，
#                   例如一天只触发两次的节日台词。
#
# 时区回复、LLM、贴吧、复读、接龙等系统规则的限流桶
# 已在 quickquip/chat/config.py 中预定义，此处只需定义文字规则专用桶。
# 注意：多条规则可以共用同一个桶，命中任意一条都消耗同一个配额。
# 梗文类桶保持默认 scope（group）即可；仅当桶里的规则会打外部 API 或共享池时，
# 才考虑显式写 scope = "global"。

[rate_limit_rules]
group_meme         = {global_limit = 6, user_limit = 3}
play_target        = {global_limit = 6, user_limit = 3}
double_char_ni_de  = {global_limit = 6, user_limit = 3}
sandwich_de        = {global_limit = 6, user_limit = 3}
like_reply         = {global_limit = 6, user_limit = 3}
divine_arrival     = {global_limit = 4, user_limit = 2}
new_three_kingdoms = {global_limit = 12, user_limit = 6}
# 文生图：全局共享配额（scope = "global"），每分钟全局最多 10 次，单用户最多 2 次
image_gen          = {global_limit = 10, user_limit = 2, scope = "global", window = 60}
# 示例：10 分钟冷却的长窗口桶（window 字段按规则自定义）
# long_cooldown    = {global_limit = 3, user_limit = 1, window = 600}

# ══════════════════════════════════════════════════════════
# [[rules]] — 回复规则列表
# ══════════════════════════════════════════════════════════
#
# 每条规则用 [[rules]] 定义，必填字段：
#   name           - 规则唯一名称，用于统计（/stats）和开关控制（/disable /enable）
#   patterns       - 触发正则列表（TOML 字面量字符串，用单引号避免反斜杠被转义）
#                    支持多条，任意一条命中即触发
#   reply_template - 回复模板（与 reply_templates 二选一）
#   rate_limit_key - 使用的限流桶名称（需在 [rate_limit_rules] 中定义，或引用系统预定义桶）
#   priority       - 优先级（整数越大越优先；同一消息命中多条规则时只触发最高优先级那条）
#
# 可选字段：
#   reply_templates      - 加权随机回复列表（与 reply_template 二选一）
#   blocked_named_groups - 命名捕获组黑名单；命中黑名单值时不触发，继续尝试下一条规则
#   blocked_groups       - 位置捕获组黑名单（按组号索引），用法同上
#
# 模板变量：
#   {sender_name}   - 发送者昵称
#   {current_time}  - 当前北京时间（YYYY-MM-DD HH:MM）
#   {user_id}       - 发送者 QQ 号
#   {命名捕获组名}  - 正则命名捕获组，如 (?P<target>...) → {target}
#   $1, $2, …       - 正则位置捕获组

# ——— 示例：彩蛋回复（固定触发词 → 含时间和昵称的回复）———
[[rules]]
name           = 'divine_arrival'
patterns       = ['神临', '降临']
reply_template = '{current_time}，@{sender_name} 区从天降'
rate_limit_key = 'divine_arrival'
priority       = 100

# ——— 示例：检测"XX，启动！"之类的格式 ———
[[rules]]
name           = 'genshin_start'
patterns       = ['^(.+?)[，,]\s*启动[！!]*$']
reply_template = '该启动$1了，少爷'
rate_limit_key = 'group_meme'
priority       = 95

# ——— 示例：检测"玩XX玩的" ———
[[rules]]
name           = 'play_target'
patterns       = ['玩(?P<target>.+?)玩的']
reply_template = '{target}怎么你了'
rate_limit_key = 'play_target'
priority       = 85

# ——— 示例：检测"AA你的"（叠字 + 你的）→ "AA牛魔" ———
[[rules]]
name           = 'double_char_ni_de'
patterns       = ['^([\u4e00-\u9fa5])(\1)你的$']
reply_template = '$1牛魔'
rate_limit_key = 'double_char_ni_de'
priority       = 80

# ——— 示例：检测"A…A的"（首尾相同汉字夹内容）→ "…怎么你了！" ———
[[rules]]
name           = 'sandwich_de'
patterns       = ['^([\u4e00-\u9fa5])(.{2,})\1的$']
reply_template = '$2怎么你了！'
rate_limit_key = 'sandwich_de'
priority       = 75

# ——— 示例：检测"我喜欢XX"或"喜欢XX" ———
[[rules]]
name           = 'like_reply'
patterns       = ['^我喜欢(.+)$', '^喜欢(.+)$']
reply_template = '还在$1'
rate_limit_key = 'like_reply'
priority       = 60

# ——— 示例：检测"我XX"（二字动词），过滤常见口语 ———
# blocked_named_groups 指定捕获组 verb 的黑名单，命中黑名单时不触发
[[rules]]
name           = 'i_do'
patterns       = ['^我(?P<verb>[\u4e00-\u9fa5]{2})[！!。，,？?]*$']
reply_template = '不准$1'
rate_limit_key = 'group_meme'
priority       = 20

[rules.blocked_named_groups]
verb = [
    '不会', '不能', '不要', '以为', '支持', '反对', '同意', '喜欢', '回去', '回家',
    '害怕', '希望', '忘了', '忘记', '担心', '明白', '来了', '知道', '觉得', '认为',
    '记得', '认识', '说过', '谢谢', '输了', '赢了',
]

# ——— 示例：加权随机回复（reply_templates 代替 reply_template）———
# [[rules]]
# name           = 'example_random'
# patterns       = ['示例触发词']
# rate_limit_key = 'group_meme'
# priority       = 10
#
# [[rules.reply_templates]]
# template = '回复A'
# weight   = 2
#
# [[rules.reply_templates]]
# template = '回复B'
# weight   = 1

# ══════════════════════════════════════════════════════════
# [[context_rules]] — 需要历史上下文的回复规则
# ══════════════════════════════════════════════════════════
#
# 与 [[rules]] 的区别：普通 rules 只看当前消息命中正则即回复；
# context_rules 在 pattern 命中后还会再做一步「语境判定」，只有
# 语境合适时才触发，避免常见字/词在无关场合乱触发。
#
# 执行时机：在普通 rules 全部未命中之后、时区回复之前尝试。
# 仅在群聊中生效（私聊不调用），且 resolve_reply 会把最近消息列表
# 透传进来做判定。
#
# ── 必填字段 ──
#   name           - 规则唯一名称
#   type           - 'regex_context' 或 'llm_context'
#   patterns       - 快速首筛正则列表（和 [[rules]] 的 patterns 一样）
#   reply_template - 回复模板（或 reply_templates）
#   rate_limit_key - 限流桶
#   priority       - 优先级；同一消息命中多条 context_rules 时取最高者
#
# ── regex_context 专属 ──
#   context_conditions - 上下文条件正则列表；需要在最近 N 条消息中
#                        搜到任意一条匹配才放行。**留空会被视为不放行**
#                        （该规则永远不会触发，模块加载时会打 warning）
#   context_window     - 查看最近多少条消息（默认 5）
#
# ── llm_context 专属 ──
#   llm_judge_prompt - 判定 prompt；会自动附带最近群聊记录与当前消息，
#                      要求模型只输出 {"trigger": true/false} JSON
#   llm_timeout      - LLM 调用超时秒数（默认 2.0；超时视为不触发）
#   llm_cache_ttl    - 按 (rule_name, group_id, text) 缓存判定结果的
#                      秒数（默认 60）。可降低常见触发词的 LLM 调用频次
#
# 模板变量和捕获组引用与 [[rules]] 完全一致。

# ——— 示例：regex_context（历史里出现「请假」类词时，本句的"竟然不许"才触发）———
# [[context_rules]]
# name               = 'leave_denied'
# type               = 'regex_context'
# patterns           = ['竟然|不许|不行|拒了|没批|不准|不给过']
# context_conditions = ['请假|休息|调休|申请|审批|报备|请假条|病假|年假']
# context_window     = 5
# reply_template     = '竟然不许！？'
# rate_limit_key     = 'group_meme'
# priority           = 99

# ——— 示例：llm_context（仅当语境真的是"他过江我也过江"时才触发）———
# [[context_rules]]
# name             = 'me_too_follow'
# type             = 'llm_context'
# patterns         = ['好啊']
# context_window   = 6
# llm_judge_prompt = '''群友发了"好啊"或类似赞同词。请根据最近记录判断：当前语境是否在说"他/某人做某事，我也要做同样的事"（类似"他过江我也过江"）？只输出 JSON：{"trigger": true/false}'''
# llm_timeout      = 2.0
# llm_cache_ttl    = 60
# reply_template   = '好啊，他过江我也过江'
# rate_limit_key   = 'group_meme'
# priority         = 100

# ══════════════════════════════════════════════════════════
# [[chain_games]] — 正则触发接龙游戏
# ══════════════════════════════════════════════════════════
#
# 每局接龙用 [[chain_games]] 定义，必填字段：
#   name            - 规则唯一名称（用于统计和开关控制）
#   trigger_pattern - 触发正则（TOML 字面量字符串，用单引号）；支持捕获组
#   chain           - 接龙序列（字符串数组）
#   rate_limit_key  - 使用的限流桶（需在 [rate_limit_rules] 中定义或引用系统预定义桶）
#
# 可选字段：
#   timeout_seconds - 每步超时秒数（默认 60）
#
# ── chain 序列格式 ──
#
# chain[0]            — bot 的开场回复
# chain[1], [3], …    — 用户依次需要说的内容（奇数位）
# chain[2], [4], …    — bot 依次的回复（偶数位 ≥ 2）
#
# 奇数长度（如 7 个元素）：最后一个 bot 回复发出后会话自动结束。
# 偶数长度（如 8 个元素）：最后一个元素为「静默终止 token」——用户在任意
#   时刻发出该 token，会话立即结束且 bot 不回复。
#
# ── 捕获组引用 ──
#
#   $1       — trigger_pattern 第 1 个捕获组的完整文本
#   $1[0]    — 第 1 个捕获组的第 1 个字符（首字）
#   $1[-1]   — 第 1 个捕获组的最后一个字符（尾字）
#   $1[2]    — 第 1 个捕获组中索引为 2 的字符
#   $2、$2[0] 等同理（对应第 2 个捕获组）
#
# ── 内置示例：好姐姐接龙（此段保持注释，作为参考；实际由代码内置提供）──
#
# [[chain_games]]
# name            = 'good_girl_chain'
# trigger_pattern = '^(.+?)是好(.+?)吗[？?]*$'
# chain           = ['别', '逗', '你', '$1[0]', '姐', '笑', '了', '句号|。', '🤣']
# timeout_seconds = 60
# rate_limit_key  = 'good_girl_chain_entry'
#
# 说明：
#   触发：用户发送「XX是好YY吗」
#   $1[0] 取主语第一个字，嵌入接龙序列第 4 位
#   第 8 位 '句号|。' 是用户步（竖线 = 或，说“句号”或"。"皆可）
#   9 元素奇数长度：末位 '🤣' 是 bot 的收尾回复，发出后会话自动结束

# ——— 示例：自定义三步接龙（奇数长度，自动结束）———
# [[chain_games]]
# name            = 'launch_chain'
# trigger_pattern = '^(.+?)[，,]\s*启动[！!]*$'
# chain           = ['准备', '就绪', '$1[0]', '冲！']
# timeout_seconds = 60
# rate_limit_key  = 'group_meme'

# ══════════════════════════════════════════════════════════
# 新三国梗 — 默认入库的通用梗
# ══════════════════════════════════════════════════════════
#
# 下列 rules / context_rules 是《新三国》电视剧的知名台词与经典梗，
# 知名度高、老少皆宜，作为默认回复入库。共用 new_three_kingdoms 限流桶。
# 如不需要可整段删除或按需关闭（/disable 规则名）。

# ─── 1. rules（直接正则触发） ───────────────────────────────

[[rules]]
name           = 'ntk_nizoule'
patterns       = ['你走了']
reply_template = '我们吃什么'
rate_limit_key = 'new_three_kingdoms'
priority       = 100

[[rules]]
name           = 'ntk_chishenme'
patterns       = ['吃什么']
reply_template = '是啊，吃什么'
rate_limit_key = 'new_three_kingdoms'
priority       = 99

[[rules]]
name           = 'ntk_yongheng'
patterns       = ['永恒的问题']
reply_template = '是啊'
rate_limit_key = 'new_three_kingdoms'
priority       = 98

[[rules]]
name           = 'ntk_sanjun'
patterns       = ['三军听令']
reply_template = '战至最后一刻'
rate_limit_key = 'new_three_kingdoms'
priority       = 97

[[rules]]
name           = 'ntk_zuihouyike'
patterns       = ['(.{1,12}?)最后一刻']
reply_template = '战至最后一刻，自刎归天！'
rate_limit_key = 'new_three_kingdoms'
priority       = 96

[[rules]]
name           = 'ntk_longerduo'
patterns       = ['扎聋我自己的耳朵', '议论孔明先生']
reply_template = '我再听到你们议论孔明先生，我就扎聋我自己的耳朵'
rate_limit_key = 'new_three_kingdoms'
priority       = 95

[[rules]]
name           = 'ntk_sibukong'
patterns       = ['死不可怕']
reply_template = '死是凉爽的夏夜'
rate_limit_key = 'new_three_kingdoms'
priority       = 94

[[rules]]
name           = 'ntk_xiaye'
patterns       = ['凉爽的夏夜']
reply_template = '可供人无忧的安眠'
rate_limit_key = 'new_three_kingdoms'
priority       = 93

[[rules]]
name           = 'ntk_bushi'
patterns       = ['不是(?P<name>.+?)害了你']
reply_template = '不是{name}害了你，是这乱世害了你啊'
rate_limit_key = 'new_three_kingdoms'
priority       = 92

[[rules]]
name           = 'ntk_long'
patterns       = ['([龙聋])']
reply_template = '$1，可是帝王之征啊'
rate_limit_key = 'new_three_kingdoms'
priority       = 91

[[rules]]
name           = 'ntk_huozhe'
patterns       = ['还活着吗']
reply_template = '生死不明'
rate_limit_key = 'new_three_kingdoms'
priority       = 90

[[rules]]
name           = 'ntk_shengsibuiming'
patterns       = ['生死不明']
reply_template = '那就是亖了'
rate_limit_key = 'new_three_kingdoms'
priority       = 89

[[rules]]
name           = 'ntk_ququer'
patterns       = ['蛐蛐儿', '有情有义', '我在想']
reply_template = '我在想我的那些个蛐蛐儿，它们个个有情有义'
rate_limit_key = 'new_three_kingdoms'
priority       = 88

[[rules]]
name           = 'ntk_gongxi'
patterns       = ['恭喜(?P<person>.+?)可以(称帝|撑地)了']
reply_template = '恭喜{person}可以$2了'
rate_limit_key = 'new_three_kingdoms'
priority       = 87

[[rules]]
name           = 'ntk_dafu'
patterns       = ['当浮一大白']
reply_template = '当浮一大白'
rate_limit_key = 'new_three_kingdoms'
priority       = 86

[[rules]]
name           = 'ntk_dehaoa'
patterns       = ['得好啊']
reply_template = '当浮一大白'
rate_limit_key = 'new_three_kingdoms'
priority       = 85

[[rules]]
name           = 'ntk_bukeqi'
patterns       = ['我是不会客气的']
reply_template = '来人'
rate_limit_key = 'new_three_kingdoms'
priority       = 84

[[rules]]
name           = 'ntk_lairen'
patterns       = ['来人']
reply_template = '换大盏'
rate_limit_key = 'new_three_kingdoms'
priority       = 83

# ─── 2. context_rules（需要历史上下文或 LLM 判定） ─────────

[[context_rules]]
name             = 'ntk_haoa'
type             = 'llm_context'
patterns         = ['好啊']
context_window   = 6
llm_judge_prompt = '''群友发了"好啊"或类似赞同词。请根据最近记录判断：当前语境是否在说"他/某人做某事，我也要做同样的事"（类似"他过江我也过江"）？只输出 JSON：{"trigger": true/false}'''
reply_template   = '好啊，他过江我也过江'
rate_limit_key   = 'new_three_kingdoms'
priority         = 100

[[context_rules]]
name               = 'ntk_jingranbuxu'
type               = 'regex_context'
patterns           = ['竟然|不许|不行|拒了|没批|不准|不给过']
context_conditions = ['请假|休息|调休|申请|审批|报备|出去|离开|请假条|病假|年假']
context_window     = 5
reply_template     = '竟然不许！？'
rate_limit_key     = 'new_three_kingdoms'
priority           = 99

[[context_rules]]
name               = 'ntk_shengbi'
type               = 'regex_context'
patterns           = ['胜兵必骄|骄兵必败|败兵必哀|哀兵必胜']
context_conditions = ['胜|败|骄|哀|兵|心态|膨胀|谦虚']
context_window     = 5
reply_template     = '胜兵必骄，骄兵必败，败兵必哀，哀兵必胜，胜兵必骄……'
rate_limit_key     = 'new_three_kingdoms'
priority           = 98

[[context_rules]]
name               = 'ntk_tianyi'
type               = 'regex_context'
patterns           = ['天意|命中注定|没办法|上天的安排']
context_conditions = ['天意|命运|注定|老天|没辙|没办法']
context_window     = 8
reply_template     = '天意，天意啊'
rate_limit_key     = 'new_three_kingdoms'
priority           = 97

[[context_rules]]
name             = 'ntk_diyixiongguan'
type             = 'llm_context'
patterns         = ['(.{1,10}?)真乃第一(.{1,10}?)', '(.{1,10}?)实乃第一(.{1,10}?)']
context_window   = 5
llm_judge_prompt = '''群友可能在用夸张语气夸赞某事物是"第一xx"。请判断：当前消息是否在玩"徐州城不愧为中原第一雄关"的梗，或是否适合用该台词接话？只输出 JSON：{"trigger": true/false}'''
reply_template   = '徐州城不愧为中原第一雄关'
rate_limit_key   = 'new_three_kingdoms'
priority         = 96

[[context_rules]]
name             = 'ntk_liangjian'
type             = 'llm_context'
patterns         = ['我有两(.{1,8}?)']
context_window   = 5
llm_judge_prompt = '''群友在说"我有两个xx"或持有两件某物的语境。请判断：当前消息是否适合接"一把叫仁之剑，一把叫义之剑"这个梗？只输出 JSON：{"trigger": true/false}'''
reply_template   = '一把叫仁之剑，一把叫义之剑'
rate_limit_key   = 'new_three_kingdoms'
priority         = 95

[[context_rules]]
name               = 'ntk_caocaomengde'
type               = 'regex_context'
patterns           = ['一息尚存|还没死|活着|战无不胜']
context_conditions = ['曹操|曹孟德|逆天|顽强|硬|死不了']
