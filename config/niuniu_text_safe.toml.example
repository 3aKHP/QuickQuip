# 牛牛大作战安全文案
# 使用方式：复制为 niuniu_text_safe.toml，在 games.toml [niuniu] 下配置：
#   niuniu_safe_text_path = "config/niuniu_text_safe.toml"
# 未在此文件中定义的字段会自动从内置默认值补全，因此只需写需要覆盖的部分。

# ── 需要和谐的打胶事件 ──

[[glue.events]]
name = "special_boost"
weight = 4
category = "growth"
pos = [
    "一股神秘力量涌来！牛牛暴增 {diff} cm！",
    "天降祥瑞！牛牛增长了 {diff} cm！",
    "幸运之星照耀了你！牛牛暴增 {diff} cm！",
]

[[glue.events]]
name = "frenzy"
weight = 4
category = "frenzy"
pos = [
    "💥 你进入了狂暴状态！牛牛暴涨 {diff} cm！",
    "肾上腺素飙升！牛牛怒长了 {diff} cm！",
    "你进入了超专注状态，牛牛暴增 {diff} cm！",
]

[[glue.events]]
name = "shrinkage"
weight = 8
category = "shrinkage"
neg = [
    "由于你在换蛋期打胶，牛牛发生了神秘变化！当前长度 {new_length} cm！",
    "bro换蛋期就不要打胶了！你的牛牛萎缩了 {diff} cm！",
]

[[glue.events]]
name = "arrested"
weight = 2
category = "arrested"
pos = [
    "打胶时体力不支，你被强制休息 {ban_time}s！",
]

# ── 需要和谐的长度评价 ──

[[glue.length_comments]]
min = -1000000000
max = -1000
messages = [
    "你已经超越了维度的界限……",
    "凡人无法理解的高度，你已经成为了传说！",
]

[[glue.length_comments]]
min = -1000
max = -100
messages = [
    "哇哦！你已经进化成深渊领主了！深渊领主在击剑时有几率吞噬对方牛牛呢！",
]

[[glue.length_comments]]
min = -100
max = -50
messages = [
    "嗯……好像已经穿过了界限吧……从另一面来看也可以算是凸出来的吧？",
    "WOW，真的凹进去了好多呢！",
]

[[glue.length_comments]]
min = -50
max = -25
messages = [
    "作为一名凹牛玩家，你的身体很健康哦！",
    "你已经是我们凹牛党的一员啦！",
]

[[glue.length_comments]]
min = -25
max = -10
messages = [
    "你已经是一名凹牛玩家了呢！",
    "从凹牛的角度来说，你练得不错哦！",
    "你醒啦？你的牛牛已经凹进去了啦！",
]

[[glue.length_comments]]
min = -10
max = 0
messages = [
    "安了安了，不要伤心嘛，凹牛有什么不好的啊",
    "加油加油！我看好你哦！",
    "做一只有凹度的牛牛吧！",
]

[[glue.length_comments]]
min = 0
max = 10
messages = [
    "你要加油哦！练练总会变长的！",
    "虽然短，但是小小的也很可爱呢",
    "像一只蚕宝宝",
]

[[glue.length_comments]]
min = 50
max = 100
messages = [
    "你这个长度太夸张了……！",
    "你是什么怪物，不要过来啊！！",
    "惊世骇俗！你已经进化成牛头人了！牛头人在击剑时有几率支配对手！",
]

# ── 需要和谐的击剑事件 ──

[[fence.events]]
name = "dominate"
weight = 30
require_role = "niutouren"
win_pos = [
    "👹 牛头人威压降临！你支配了对手！+{gain} cm，对方 -{loss} cm！",
    "牛头人之力爆发！你击退了对手！+{gain} cm！！",
]
win_neg = [
    "👹 牛头人威压降临！你的凹牛牛顺势膨胀了 {gain} cm！",
]
lose_pos = [
    "👹 对方使出了牛头人威压！你被压制了，-{loss} cm...",
    "牛头人压制了你！损失 {loss} cm...",
]
lose_neg = [
    "👹 对方牛头人威压！你的牛牛被压得更凹了...",
]
sever_pos = [
    "👹 牛头人腰斩！！你重创了对方！{loss} cm 灰飞烟灭！你吸收 {gain} cm！",
    "⚔️ 牛头人处刑！对方损失 {loss} cm，你获得 {gain} cm！",
    "🪓 牛头人断头台！对方牛牛被击落 {loss} cm，你增长了 {gain} cm！",
]
sever_neg = [
    "👹 牛头人支配！你击穿了对方的防线！深度从 {old_oppo} 翻倍至 {new_oppo} cm！你吸收 {gain} cm！",
    "深渊之力！牛头人的一击让对方的凹度暴增至 {new_oppo} cm！你获得 {gain} cm！",
]
severed_pos = [
    "👹 对方牛头人腰斩！！你的牛牛被击落 {loss} cm！当前 {my_len} cm",
    "⚔️ 对方牛头人处刑！你的牛牛损失 {loss} cm！",
    "🪓 对方牛头人断头台降临！你被击落 {loss} cm...",
]
severed_neg = [
    "👹 对方牛头人支配！你的凹度从 {old_my} 暴增至 {new_my} cm！",
    "深渊之力！对方牛头人的一击让你的凹度加倍到 {new_my} cm...",
]

[[fence.events]]
name = "succubus_devour"
weight = 30
require_role = "succubus"
win_pos = [
    "👁 深渊吞噬！你从对方身上夺取了 {gain} cm，对方损失 {loss} cm！",
    "深渊之吻吸走了对方的力量！你增长了 {gain} cm！",
]
win_neg = [
    "👁 深渊吞噬！你的凹度吸收了对方 {gain} cm！",
]
devoured_pos = [
    "👁 对方深渊吞噬了你！{loss} cm 被吸走...当前 {my_len} cm",
    "深渊之吻降临！你被吸走了 {loss} cm，对方增长了 {gain} cm！",
]
devoured_neg = [
    "👁 对方深渊吞噬！你的凹度被吸得更深了...当前 {my_len} cm",
]

# ── 运势提示 ──

[[luck.glue]]
min = 3.0
max = 999.0
text = "运势如虹！今日打胶效果极佳，加油！！"

# ── CD 提示 ──

[cd]
fence = [
    "不行不行，你的身体会受不了的，歇 {remaining}s 再来吧",
    "打咩哟！你的牛牛会炸的，休息 {remaining}s 再来吧",
    "击剑太频繁啦！歇 {remaining}s 再来吧",
]
