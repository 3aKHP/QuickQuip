# QuickQuip 游戏配置文件模板
# 复制为 config/games.toml 后修改，所有字段均可选，未设置时使用默认值。

# ── 金币经济系统 ────────────────────────────────────────────────────────

[economy]
# 每日签到基础金币奖励
sign_base_gold = 10
# 连续签到每天额外加成（实际加成 = streak_bonus × (连续天数 - 1)）
sign_streak_bonus = 2
# 连续签到加成上限
sign_max_streak_bonus = 30
# 每次签到获得的好感度
affection_per_sign = 1

# ── 数字炸弹 ────────────────────────────────────────────────────────────

[number_bomb]
# 数字范围下限
min_number = 1
# 数字范围上限
max_number = 1000
# 超时秒数（无操作自动结束）
timeout_seconds = 60

# ── 21 点（Blackjack）────────────────────────────────────────────────────

[blackjack]
# 最低赌注（金币）
min_bet = 20
# 最大玩家数（含庄家为 N + 1）
max_players = 8
# 超时秒数
timeout_seconds = 90
# 庄家停牌阈值（达到此点数不再要牌）
dealer_stand_threshold = 17

# ── 俄罗斯轮盘 ──────────────────────────────────────────────────────────

[russian_roulette]
# 弹仓槽数
cylinder_slots = 7
# 最低赌注（金币）
min_bet = 20
# 超时秒数
timeout_seconds = 30

# ── 牛牛大作战 ──────────────────────────────────────────────────────────

[niuniu]
# 击剑 CD（秒）
fence_cooldown = 180
# 被击剑保护期（秒）
fenced_protection = 300
# 打胶 CD（秒）
glue_cooldown = 180
# 注销牛牛所需金币
unsubscribe_gold = 500
# 长度超过 50 时的衰减率
decay_rate_high = 0.01
# 正常长度衰减率
decay_rate_normal = 0.005
# 衰减下限（长度不会低于此值）
decay_floor = -1000000.0
# ── 回归压力（防止数值膨胀）──────────────────────────────────────────
# 极端 |length| 时，向外变化（远离 0）被抑制，向内变化（靠近 0）被放大
# pressure = min((|length| - threshold) / scale, max_pressure)
# 默认值：|length|=50 时为 0，|length|=500 时达到 0.5（上限）
regression_threshold = 50.0
regression_scale = 900.0
regression_max_pressure = 0.5

# ── 打胶事件参数 ────────────────────────────────────────────────────────
# 幸运日 growth 倍率
glue_lucky_coefficient = 1.8
# 神秘力量 growth 倍率
glue_special_coefficient = 1.3
# 换蛋期缩水率（长度 × 此值）
glue_shrinkage_effect = 0.5
# 噩梦缩水率
glue_nightmare_effect = 0.7
# 被捕小黑屋时长（秒）
glue_arrested_duration = 180
# 牛神祝福增长范围 (cm)
glue_blessing_min = 3.0
glue_blessing_max = 10.0
# 赌徒输赢幅度范围 (cm)
glue_gambler_min = 2.0
glue_gambler_max = 7.0
# 贤者模式增长范围 (cm)
glue_zen_min = 0.3
glue_zen_max = 1.5
# 狂暴增长范围 (cm)
glue_frenzy_min = 1.5
glue_frenzy_max = 5.0

# ── 击剑事件参数 ────────────────────────────────────────────────────────
# 暴击倍率
fence_critical_multiplier = 1.8
# 擦边倍率
fence_glancing_multiplier = 0.4
# 牛头人支配倍率（腰斩未触发时使用）
fence_dominate_multiplier = 3.0
# 牛头人腰斩触发概率（0-1）。触发后对方长度减半（正）或翻倍（负）
fence_dominate_sever_chance = 0.4
# 触发支配的最低长度
fence_dominate_threshold = 50.0
# 魅魔吞噬窃取比例（窃取 min(|a|,|b|) × 此值）
fence_devour_steal_ratio = 0.3
# 触发魅魔吞噬的最低 abs 长度（深度）
fence_devour_threshold = 50.0
# 平局双方损失范围 (cm)
fence_draw_min = 0.5
fence_draw_max = 2.0

# ── 无牛牛目标击剑参数 ──────────────────────────────────────────────────
# 挥空自伤范围 (cm)
fence_self_hurt_min = 0.5
fence_self_hurt_max = 2.5

# ── 机器人击剑参数 ──────────────────────────────────────────────────────
# 机器人幻影牛牛长度范围 (cm)
fence_bot_phantom_min = 5.0
fence_bot_phantom_max = 80.0

# ── 每日运势 ────────────────────────────────────────────────────────────
# lg(运势) ~ N(0, σ)，σ=1 → 中位数=1，±1σ=[0.1, 10]，无硬上下限
# 打胶运势乘算打胶结果，击剑运势影响击剑胜率

# 打胶运势对数标准差
luck_sigma = 1.0
# 击剑运势对数标准差
fence_luck_sigma = 1.0
