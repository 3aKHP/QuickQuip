# QuickQuip 游戏配置文件模板
# 复制为 config/games.toml 后修改，所有字段均可选，未设置时使用默认值。

# ── 金币经济系统 ────────────────────────────────────────────────────────

[economy]
# 每日签到基础金币奖励
sign_base_gold = 10
# 连续签到每天额外加成（实际加成 = streak_bonus × (连续天数 - 1)）
sign_streak_bonus = 2
# 连续签到加成上限
sign_max_streak_bonus = 30
# 每次签到获得的好感度
affection_per_sign = 1

# ── 数字炸弹 ────────────────────────────────────────────────────────────

[number_bomb]
# 数字范围下限
min_number = 1
# 数字范围上限
max_number = 1000
# 超时秒数（无操作自动结束）
timeout_seconds = 60

# ── 21 点（Blackjack）────────────────────────────────────────────────────

[blackjack]
# 最低赌注（金币）
min_bet = 20
# 最大玩家数（含庄家为 N + 1）
max_players = 8
# 超时秒数
timeout_seconds = 90
# 庄家停牌阈值（达到此点数不再要牌）
dealer_stand_threshold = 17

# ── 俄罗斯轮盘 ──────────────────────────────────────────────────────────

[russian_roulette]
# 弹仓槽数
cylinder_slots = 7
# 最低赌注（金币）
min_bet = 20
# 超时秒数
timeout_seconds = 30

# ── 牛牛大作战 ──────────────────────────────────────────────────────────

[niuniu]
# 击剑 CD（秒）
fence_cooldown = 180
# 被击剑保护期（秒）
fenced_protection = 300
# 打胶 CD（秒）
glue_cooldown = 180
# 注销牛牛所需金币
unsubscribe_gold = 500
# 长度大于 50 时的缩短比例；长度小于 -50 时，绝对值缩小此值的 0.4 倍
decay_rate_high = 0.01
# [-50, 50] 范围内的调整率：正长度缩短此比例，负长度绝对值增加此值的 0.8 倍
decay_rate_normal = 0.005
# 打胶凹侧 sublinear 加深强度（越大凹侧萎缩越深，1.0 为线性基准）
glue_neg_shrink_depth = 1.0

# ── 打胶事件参数 ────────────────────────────────────────────────────────
# 幸运日 growth 倍率
glue_lucky_coefficient = 1.8
# 神秘力量 growth 倍率
glue_special_coefficient = 1.3
# 换蛋期缩水率（长度 × 此值）
glue_shrinkage_effect = 0.5
# 噩梦缩水率
glue_nightmare_effect = 0.7
# 被捕小黑屋时长（秒）
glue_arrested_duration = 60
# 牛神祝福增长范围 (cm)
glue_blessing_min = 5.0
glue_blessing_max = 18.0
# 赌徒输赢幅度范围 (cm)
glue_gambler_min = 4.0
glue_gambler_max = 14.0
# 贤者模式增长范围 (cm)
glue_zen_min = 1.0
glue_zen_max = 4.0
# 狂暴增长范围 (cm)
glue_frenzy_min = 3.0
glue_frenzy_max = 10.0

# ── 击剑奖励与事件参数 ──────────────────────────────────────────────────
# g = √(|a|×|b|)，基础奖励 R = base + scale × ln(1 + g/length_scale)
# 运势乘数 F = 0.5 + 0.5 × log₂(1 + √luck)，两条曲线均无上界
# 胜者奖励 T = R × F × U(0.8, 1.2) × 事件倍率（保留两位小数）
fence_reward_base = 0.8
fence_reward_scale = 1.5
fence_reward_length_scale = 30.0
# 败者承担胜者奖励的比例；平局双方无变化。机器人胜负各半、盈亏对称。
fence_loss_ratio = 0.5
# 暴击、擦伤、支配、重斩、吞噬的奖励倍率
fence_critical_multiplier = 1.8
fence_glancing_multiplier = 0.4
fence_dominate_multiplier = 2.0
fence_heavy_multiplier = 3.0
fence_devour_multiplier = 2.5
# 支配事件中重斩的触发概率
fence_dominate_sever_chance = 0.4
# 牛头人与魅魔的角色门槛
fence_dominate_threshold = 50.0
fence_devour_threshold = 50.0

# ── 无牛牛目标击剑参数 ──────────────────────────────────────────────────
# 挥空自伤范围 (cm)
fence_self_hurt_min = 0.5
fence_self_hurt_max = 2.5

# ── 每日运势 ────────────────────────────────────────────────────────────
# lg(运势) ~ N(0, σ)，σ=1 → 中位数=1，±1σ=[0.1, 10]，无硬上下限
# 打胶运势乘算打胶结果，击剑运势影响击剑胜率

# 打胶运势对数标准差
luck_sigma = 1.0
# 击剑运势对数标准差
fence_luck_sigma = 1.0
# 打胶运势幂压缩指数（luck^0.75：1**α==1 故中位运势行为不变，仅温和化极端运势的实际影响）
luck_power = 0.75

# ── 牛牛 RPM 限流 ────────────────────────────────────────────────────────
# 打胶每分钟每群请求上限
glue_rpm_limit = 30
# 击剑每分钟每群请求上限
fence_rpm_limit = 20
# RPM 滑动窗口大小（秒）
rpm_window_seconds = 60

# ── 牛牛文案预设 ────────────────────────────────────────────────────────
# 自定义文案 TOML 路径（为空则使用内置 default 文案）
# niuniu_text_path = "config/niuniu_text.toml"
# 和谐版文案 TOML 路径（为空则使用内置 safe 文案）
# niuniu_safe_text_path = "config/niuniu_text_safe.toml"
