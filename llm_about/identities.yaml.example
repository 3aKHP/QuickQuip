# ── QuickQuip 标准身份词表 ──────────────────────────────────────────────
# 复制为 identities.yaml 后按你的群编辑。
#
# 作用：
# - 按 QQ 号把群友稳定映射到标准身份
# - 给 LLM 的提问者身份、最近群聊上下文、艾特解析提供统一来源
#
# 填写说明：
# - `canonical_name` 是标准身份名
# - 在 `qq_ids` 下面填入该人的稳定 QQ 号字符串
# - 如果同一人长期使用多个号，可以写多个
# - `aliases` 只放明确别名，过泛的通配称呼写进 `note`

people:
  - canonical_name: 张三
    qq_ids:
      - "1234567890"
    aliases:
      - 三哥
      - 哈基三
    note: 大部分以三字开头的称呼通常指张三，例如三神、三区、三出。

  - canonical_name: 李四
    qq_ids:
      - "0987654321"
    aliases:
      - 小李
      - 四爷
    note: 注意不要和明星李四混淆。

# 如需声明机器人自己用的 QQ 号（让 LLM 知道"这个号是机器人"）：
#
# special_accounts:
#   - qq_id: "9998887776"
#     canonical_name: Bot
#     aliases:
#       - 机器人
#     note: 这是机器人自己的号，但群主偶尔也会用这个号发言。
